#!/bin/sh
# Runs the full-game slow tests before every push.
# Install once per clone: git config core.hooksPath scripts/git-hooks
# Skip for one push: git push --no-verify
repo_root=$(git rev-parse --show-toplevel)
python="$repo_root/.venv/bin/python"
[ -x "$python" ] || python=python3
exec "$python" -m pytest "$repo_root/tests/slow" -q
